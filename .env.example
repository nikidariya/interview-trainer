# Скопируйте этот файл в .env и подставьте свои значения. Файл .env в git не попадает.

# Ключ авторизации GigaChat из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=your_authorization_key_here
# Версия API: GIGACHAT_API_PERS для физических лиц (бесплатный тариф Freemium)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель GigaChat; доступные модели можно узнать через GigaChat.get_models()
GIGACHAT_MODEL=GigaChat-3-Pro
# Проверка сертификатов Минцифры: в Docker ставится автоматически. При запуске на своём компьютере без Docker поставьте false
GIGACHAT_VERIFY_SSL=true
# Таймаут одного запроса в секундах и число повторов при ошибке
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Папка для журнала вызовов агентов
LOG_DIR=logs

# PostgreSQL: set a random password before docker compose up.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=interview_trainer
POSTGRES_USER=interview
POSTGRES_PASSWORD=agents007
